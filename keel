#!/usr/bin/env sh
set -eu

SCRIPT=$0
while [ -L "$SCRIPT" ]; do
  DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd)
  TARGET=$(readlink "$SCRIPT")
  case "$TARGET" in
    /*) SCRIPT=$TARGET ;;
    *) SCRIPT=$DIR/$TARGET ;;
  esac
done

ROOT=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd)
cd "$ROOT"

if ! command -v go >/dev/null 2>&1; then
  echo "keel: Go is not installed or not on PATH." >&2
  echo "Install Go, then run: $ROOT/scripts/install-local.sh" >&2
  exit 127
fi

exec go run ./cmd/keel "$@"
